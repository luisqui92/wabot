# ─── Base de datos ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/wabot

# ─── Sesiones del panel ─────────────────────────────────────────────────────
# Obligatorio. Generalo con: openssl rand -hex 32
JWT_SECRET=

# ─── IA ─────────────────────────────────────────────────────────────────────
OPENAI_KEY=
OPENAI_MODELO=gpt-4o-mini

# ─── WhatsApp (Meta Cloud API) ──────────────────────────────────────────────
# Token de acceso: Meta -> tu app -> WhatsApp -> API Setup.
WHATSAPP_TOKEN=
# Lo definis vos, y va IGUAL en Meta al guardar la Callback URL.
WHATSAPP_VERIFY_TOKEN=
# Meta -> tu app -> Settings -> Basic -> App Secret. Firma cada webhook:
# sin esto cualquiera que adivine la URL puede inyectar mensajes falsos.
META_APP_SECRET=

# Origen publico donde corre esto, sin barra final.
APP_URL=https://wabot.chatgo.ia.bo

# Vacio cuando la app tiene su propio dominio o subdominio (lo normal, y lo
# recomendado). Solo se llena si comparte dominio con otra API y queda colgada
# de un prefijo — ej. BASE_PATH=/wabot para api.chatgo.ia.bo/wabot.
BASE_PATH=

PORT=3000
